{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
  ],
  labels: [
    'dependencies',
  ],
  timezone: 'America/Los_Angeles',
  minimumReleaseAge: '7 days',
  internalChecksFilter: 'strict',
  prCreation: 'not-pending',
  // CI runs only on PRs and main, so a Renovate branch has no checks before its PR exists.
  // Count passing minimumReleaseAge as green so PRs open without waiting prNotPendingHours.
  internalChecksAsSuccess: true,
  automergeType: 'pr',
  automergeStrategy: 'squash',
  platformAutomerge: false,
  // Merge green PRs even when behind main; otherwise each run rebases instead of merging.
  rebaseWhen: 'conflicted',
  // Merges here ship to production, so only merge while someone is around.
  automergeSchedule: [
    '* 8-11 * * 1-5',
  ],
  postUpdateOptions: [
    'gomodTidy',
  ],
  // Lets Renovate regenerate .github/workflows/actions.lock when bumping actions.
  constraints: {
    ghActionsLock: 'v0.4.1',
  },
  lockFileMaintenance: {
    enabled: true,
  },
  nix: {
    enabled: true,
  },
  'pre-commit': {
    enabled: true,
  },
  packageRules: [
    {
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin', 'pinDigest', 'lockFileMaintenance'],
      automerge: true,
    },
    {
      matchUpdateTypes: ['major'],
      automerge: false,
    },
    // go.mod's go directive and the golang builder image move together.
    {
      matchDepTypes: ['golang'],
      rangeStrategy: 'bump',
    },
    {
      matchPackageNames: ['go', 'golang'],
      groupName: 'go toolchain',
      groupSlug: 'go-toolchain',
    },
  ],
}
